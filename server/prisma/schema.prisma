// Prisma schema — nguồn duy nhất của cấu trúc CSDL. Hibernate `ddl-auto` không còn;
// mọi thay đổi schema đi qua `prisma migrate dev` và migration được commit kèm.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum PaymentTransactionStatus {
  PENDING
  PAID
}

enum MessageSender {
  USER
  BOT
}

enum DiscountType {
  PERCENT
  FIXED
}

enum PromotionScope {
  GLOBAL
  CATEGORY
  FOOD
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  password     String
  fullName     String?
  phone        String?
  address      String?
  role         Role      @default(CUSTOMER)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  orders       Order[]
  reviews      Review[]
  cartItems    CartItem[]
  notifications Notification[]
  chatMessages ChatMessage[]
  addresses    UserAddress[]

  @@map("users")
}

model UserAddress {
  id              Int      @id @default(autoincrement())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          Int      @map("user_id")
  // Tên cột address_label để tránh trùng từ khoá; field giữ `label` cho khớp client.
  addressLabel    String?  @map("address_label")
  receiverName    String   @map("receiver_name")
  phone           String
  address         String
  isDefault       Boolean  @default(false) @map("is_default")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("user_addresses")
}

model Category {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  slug        String?
  imageUrl    String? @map("image_url")
  description String?
  foods       Food[]

  @@map("categories")
}

model Food {
  id          Int       @id @default(autoincrement())
  name        String
  category    Category? @relation(fields: [categoryId], references: [id])
  categoryId  Int?      @map("category_id")
  description String?   @db.Text
  ingredients String?   @db.Text
  // Tiền luôn là DECIMAL trong DB; client nhận number VND (số nguyên).
  price       Decimal   @db.Decimal(12, 2)
  imageUrl    String?   @map("image_url")
  servingSize Int       @default(1) @map("serving_size")
  spicyLevel  Int       @default(0) @map("spicy_level")
  dietaryTags String?   @map("dietary_tags")
  allergens   String?
  available   Boolean   @default(true)
  cartItems   CartItem[]
  orderItems  OrderItem[]
  reviews     Review[]

  @@map("foods")
}

model CartItem {
  id       Int  @id @default(autoincrement())
  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   Int  @map("user_id")
  food     Food @relation(fields: [foodId], references: [id], onDelete: Cascade)
  foodId   Int  @map("food_id")
  quantity Int  @default(1)

  @@unique([userId, foodId])
  @@map("cart_items")
}

model Order {
  id            Int              @id @default(autoincrement())
  user          User             @relation(fields: [userId], references: [id])
  userId        Int              @map("user_id")
  status        OrderStatus      @default(PENDING)
  paymentMethod String?          @map("payment_method")
  paymentStatus PaymentStatus    @default(UNPAID) @map("payment_status")
  total         Decimal          @db.Decimal(12, 2)
  discountTotal Decimal          @default(0) @db.Decimal(12, 2) @map("discount_total")
  receiverName  String           @map("receiver_name")
  phone         String
  address       String
  note          String?          @db.VarChar(255)
  createdAt     DateTime         @default(now()) @map("created_at")
  items         OrderItem[]
  payment       PaymentTransaction?

  @@map("orders")
}

model OrderItem {
  id             Int     @id @default(autoincrement())
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId        Int     @map("order_id")
  // Món có thể bị xoá khỏi DB khi không còn tham chiếu; giữ nguyên dòng đơn nên orderId vẫn có,
  // food trở thành null và client đã xử lý `Food | null`.
  food           Food?   @relation(fields: [foodId], references: [id], onDelete: SetNull)
  foodId         Int?    @map("food_id")
  quantity       Int
  price          Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2) @map("discount_amount")

  @@map("order_items")
}

model PaymentTransaction {
  id        Int                      @id @default(autoincrement())
  order     Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   Int                      @unique @map("order_id")
  method    String?
  amount    Decimal                  @db.Decimal(12, 2)
  status    PaymentTransactionStatus @default(PENDING)
  createdAt DateTime                 @default(now()) @map("created_at")
  paidAt    DateTime?                @map("paid_at")

  @@map("payment_transactions")
}

model Review {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int      @map("user_id")
  food      Food     @relation(fields: [foodId], references: [id])
  foodId    Int      @map("food_id")
  rating    Int
  comment   String?  @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("reviews")
}

model Notification {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int      @map("user_id")
  content   String   @db.VarChar(1000)
  // Đơn liên quan; null với thông báo cũ nên chỉ đánh dấu đã đọc, không điều hướng.
  orderId   Int?     @map("order_id")
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

model Promotion {
  id            Int            @id @default(autoincrement())
  name          String
  description   String?        @db.VarChar(500)
  discountType  DiscountType   @default(PERCENT) @map("discount_type")
  discountValue Decimal        @db.Decimal(12, 2) @map("discount_value")
  maxDiscount   Decimal?       @db.Decimal(12, 2) @map("max_discount")
  minOrderTotal Decimal?       @db.Decimal(12, 2) @map("min_order_total")
  scope         PromotionScope @default(GLOBAL)
  targetIds     Int[]          @map("target_ids")
  startsAt      DateTime       @map("starts_at")
  endsAt        DateTime       @map("ends_at")
  // Ngày trong tuần áp dụng, phân tách bằng dấu phẩy, ví dụ MON,TUE. Null = mọi ngày.
  daysOfWeek    String?        @map("days_of_week")
  // Khung giờ áp dụng, "HH:mm"; start > end nghĩa là khung qua nửa đêm.
  startTime     String?        @map("start_time") @db.VarChar(5)
  endTime       String?        @map("end_time") @db.VarChar(5)
  active        Boolean        @default(true)
  priority      Int            @default(0)
  usageLimit    Int?           @map("usage_limit")
  usedCount     Int            @default(0) @map("used_count")
  randomCount   Int            @default(0) @map("random_count")
  createdAt     DateTime       @default(now()) @map("created_at")

  @@map("promotions")
}

model ChatMessage {
  id        Int           @id @default(autoincrement())
  user      User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int?          @map("user_id")
  sessionId String?       @map("session_id")
  sender    MessageSender
  content   String        @db.VarChar(4000)
  createdAt DateTime      @default(now()) @map("created_at")

  @@map("chat_messages")
}

// Tài liệu quán admin nhập để chatbot tra cứu; nội dung do admin viết, không phải AI tự viết.
model ChatbotKnowledge {
  id        Int      @id @default(autoincrement())
  title     String?
  category  String?
  keywords  String?
  content   String?  @db.Text
  enabled   Boolean  @default(true)
  fileName  String?  @map("file_name")
  fileSize  Int?     @map("file_size")
  /** PENDING | READY | FAILED — trạng thái chia đoạn. */
  status    String   @default("READY")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("chatbot_knowledge")
}

model ChatbotKnowledgeChunk {
  id         Int      @id @default(autoincrement())
  documentId Int      @map("document_id")
  chunkIndex Int      @map("chunk_index")
  content    String   @db.Text
  // search_vector (tsvector, GENERATED ALWAYS ... STORED) + GIN index được thêm bằng SQL
  // trong migration khởi tạo — Prisma không mô hình hoá được kiểu này, tra cứu qua $queryRaw.
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("chatbot_knowledge_chunk")
}

model AiSetting {
  settingKey   String  @id @map("setting_key")
  settingValue String? @map("setting_value") @db.Text

  @@map("ai_setting")
}
