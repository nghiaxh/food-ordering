DB_NAME=food_ordering
DB_USER=postgres
DB_PASSWORD=postgres

JWT_SECRET=doi-chuoi-nay-thanh-chuoi-bi-mat-dai-it-nhat-32-ky-tu
JWT_EXPIRATION_MS=86400000

# Don QR chua thanh toan qua so phut nay thi he thong tu huy.
ORDER_PAYMENT_TIMEOUT_MINUTES=30

# Khoa Gemini: mot khoa hoac danh sach phan tach dau phay/xuong dong. Thieu/sai thi chatbot tra 503.
AI_API_KEYS=dien_api_key_gemini_cua_ban
# Model chat: mot model hoac danh sach, thu lan luot khi model truoc loi 503/404/timeout.
AI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.6-flash
# Model embedding, phai tra ve 768 chieu.
EMBEDDING_MODELS=gemini-embedding-2